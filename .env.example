# Run ./scripts/setup.ps1 to generate .env with random local credentials.
# Never commit .env or populate this example with real credentials.
# PostgreSQL and Redis come from the shared infrastructure (D:/baolf/infra):
# POSTGRES_PASSWORD is the booth role's password there, REDIS_PASSWORD the shared Redis password (from the infra .env).
POSTGRES_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SESSION_SECRET=
AI_MODEL_ENCRYPTION_KEY=
EXTERNAL_API_URL=https://api.lingtong.net.cn
# Model provider API keys are entered in the admin console and encrypted in the database.
# Reverse proxy trust for client IPs (rate limits): hop count (e.g. 1) or comma-separated
# addresses/CIDRs/keywords (loopback, linklocal, uniquelocal). Leave empty when not behind a proxy.
TRUST_PROXY=
# Optional SMTP for quote/manual request receipt emails; without SMTP_HOST emails stay pending.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CLIENT_PUBLIC_URL=http://localhost:5030
# Optional project notification webhook; without the URL notifications stay pending in project_notification_outbox.
# The secret is required once the URL is set and must be at least 32 bytes.
PROJECT_NOTIFICATION_WEBHOOK_URL=
PROJECT_NOTIFICATION_WEBHOOK_SECRET=
