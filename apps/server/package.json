{
  "name": "@booth-ai/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "storage:init": "tsx src/scripts/storage-init.ts",
    "smoke": "tsx src/scripts/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1139.0",
    "@aws-sdk/s3-request-presigner": "3.1139.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "bullmq": "6.3.8",
    "exceljs": "^4.4.0",
    "fastify": "5.12.5",
    "ioredis": "5.11.1",
    "jszip": "3.10.2",
    "pg": "8.23.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
